@startuml request-central
skinparam svgDimensionStyle false
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam ArrowColor Black
skinparam rectangle {
  RoundCorner 25
  FontStyle bold
}
skinparam nodesep 40
skinparam ranksep 80
skinparam rectangle<<square>> {
  RoundCorner 0
}
hide stereotype
skinparam linetype polyline
left to right direction

rectangle " " as CenS1 #transparent;line:transparent
rectangle "\nRequestor\n" as CenR #d5e8d4;line:82b366
rectangle "\nCentral\nManagement\n" as CenM <<square>> #fad7ac;line:d79b00
rectangle "\nPotential Performer A\n" as CenA #b1ddf0;line:10739e
rectangle "\nPotential Performer B\n" as CenB #b1ddf0;line:10739e
rectangle "\nPotential Performer C\n" as CenC #b1ddf0;line:10739e
CenS1 --> CenR : 1. Propose service
CenR --> CenM : 2. Who can\nperform service?
CenM <..> CenA
CenM <..> CenB
CenM <..> CenC
CenM --> CenR : 3. Performer C\nAssigned
CenR --> CenC : 4. Share Additional Info\n(could be query or could be push)
@enduml
