@startuml request-bid
skinparam svgDimensionStyle false
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam ArrowColor Black
skinparam rectangle {
  RoundCorner 25
  FontStyle bold
}
skinparam nodesep 40
skinparam ranksep 80
left to right direction

rectangle " " as BidS1 #transparent;line:transparent
rectangle " " as BidS4 #transparent;line:transparent
rectangle "Requestor" as BidR #d5e8d4;line:82b366
rectangle "Potential Performer A" as BidA #b1ddf0;line:10739e
rectangle "Potential Performer B" as BidB #b1ddf0;line:10739e
rectangle "Potential Performer C" as BidC #b1ddf0;line:10739e
BidS1 --> BidR : 1. Propose service
BidR --> BidA : 2. Who Can Perform Service?
BidR --> BidB
BidR --> BidC
BidA --> BidR : 3. Bid
BidC --> BidR : 3. Bid
BidS4 --> BidR : 4. Pick Performer\n(with Patient)
BidR --> BidC : 5. Service confirmed /\nbid accepted
@enduml
